.DS_Store
.direnv/
.venv/
__pycache__/
*.egg-info/
.env
.cursor/
.ninja_log
flake.lock
uv.lock

# Experiment runtime artifacts
experiment/logs/
experiment/traces/
experiment/results/
experiment/state_*.json

artifacts/

# W&B local runs
wandb/

# Sweep heavy binaries (deterministically regenerable from grammar+seed);
# the committed config.json + analysis.json + grammar.npz keep every run
# recoverable and auditable for the paper.
results/sweep/*/model.pt
results/sweep/*/probe_data.npz
results/sweep/*/figures/
results/sweep/run_all.log

# Architecture sweep (pass 3): same policy -- commit only the recoverable
# config.json + analysis.json + grammar.npz, ignore the heavy regenerable binaries.
results/arch/*/model.pt
results/arch/*/probe_data.npz
results/arch/*/figures/
results/arch/run_arch.log
results/arch_run.out

# Depth-4 sweep (pass 4): same policy -- commit only config.json + analysis.json
# + grammar.npz, ignore the heavy regenerable binaries.
results/depth4/*/model.pt
results/depth4/*/probe_data.npz
results/depth4/*/figures/
results/depth4/run_depth4.log
